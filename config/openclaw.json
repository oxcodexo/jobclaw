{
  "gateway": {
    "mode": "local",
    "bind": "lan",
    "port": 18789
  },
  "browser": {
    "noSandbox": true
  },
  "models": {
    "providers": {
      "9router": {
        "baseUrl": "http://9router:20128/v1",
        "apiKey": "${NINE_ROUTER_API_KEY}",
        "api": "openai-completions",
        "request": {
          "allowPrivateNetwork": true
        },
        "models": []
      }
    }
  },
  "agents": {
    "defaults": {
      "workspace": "/home/node/.openclaw/workspace",
      "model": {
        "primary": "9router/jobclaw-free"
      },
      "modelPolicy": {
        "allow": ["9router/jobclaw-free", "9router/kr/claude-haiku-4.5", "9router/kr/claude-sonnet-4.5"]
      }
    }
  },
  "channels": {
    "telegram": {
      "enabled": true,
      "dmPolicy": "pairing"
    }
  },
  "plugins": {
    "entries": {
      "tavily": {
        "enabled": true
      }
    }
  },
  "tools": {
    "web": {
      "search": {
        "provider": "tavily"
      }
    }
  },
  "commands": {
    "ownerAllowFrom": ["telegram:YOUR_TELEGRAM_CHAT_ID"]
  }
}
