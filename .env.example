# Copy to .env and fill. Never commit .env.
TZ=UTC

# OpenClaw gateway
OPENCLAW_PORT=18789
# Gateway base image (used at BUILD time via Dockerfile ARG; default is the pin below).
# To float: OPENCLAW_BASE=ghcr.io/openclaw/openclaw:latest, then --build. (Old OPENCLAW_IMAGE var no longer used.)
OPENCLAW_BASE=ghcr.io/openclaw/openclaw:2026.9.9
OPENCLAW_GATEWAY_TOKEN=change-me-to-a-long-random-token

# Telegram (BotFather -> /newbot). Restrict to your chat ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# 9Router
NINE_ROUTER_PORT=20128
NINE_ROUTER_IMAGE=decolua/9router:0.5.104
# Dashboard password (replaces default 123456; required for browser access via Docker)
NINE_ROUTER_PASSWORD=change-me-to-a-long-random-password
# API key created in 9Router dashboard (Endpoint / API keys), pasted here.
# Gateway refuses to boot with an empty var (SecretRef resolution), so use a
# placeholder to boot fresh, then replace with the real key:
#   NINE_ROUTER_API_KEY=placeholder-change-me-in-9router-dashboard
NINE_ROUTER_API_KEY=placeholder-change-me-in-9router-dashboard
TAVILY_API_KEY=
