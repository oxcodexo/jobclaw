# Copy to .env and fill, or let setup create it: python scripts/setup.py
# Never commit .env.
TZ=UTC

# OpenClaw gateway
OPENCLAW_PORT=18789
# Stack versions (written by setup; no Dockerfile/Compose defaults).
# Validated pair. Rerun `python scripts/setup.py` to choose Validated or Latest;
# manual edits below are an unsupported escape hatch.
OPENCLAW_BASE=ghcr.io/openclaw/openclaw:2026.9.9
# Generated by setup if this placeholder remains.
OPENCLAW_GATEWAY_TOKEN=change-me-to-a-long-random-token

# Telegram (optional; setup configures the channel)
# allowed values: true | false
TELEGRAM_ENABLED=false
# allowed values: allowlist | pairing
TELEGRAM_DM_POLICY=allowlist
# Bot token from @BotFather (optional).
TELEGRAM_BOT_TOKEN=
# Numeric Telegram USER IDs of people allowed to DM the bot (comma-separated),
# not the bot's own ID and not group/chat IDs.
# Group chat IDs belong in channels.telegram.groups, not allowFrom.
TELEGRAM_ALLOWED_CHAT_IDS=

# 9Router
NINE_ROUTER_PORT=20128
NINE_ROUTER_IMAGE=decolua/9router:0.5.104
# Dashboard password (replaces default 123456; required for browser access via Docker).
# Generated by setup if this placeholder remains. A stored hash in the volume wins:
# changing this alone does not change an existing password.
NINE_ROUTER_PASSWORD=change-me-to-a-long-random-password
# Provisioned automatically by setup (jobclaw key). This placeholder boots a fresh
# gateway before setup completes the handoff:
NINE_ROUTER_API_KEY=placeholder-change-me-in-9router-dashboard

# Web search (optional; setup installs the selected plugin)
# allowed values: tavily | duckduckgo | disabled
WEB_SEARCH_PROVIDER=disabled
# Tavily free tier (1,000 credits/month). Required only when provider=tavily.
TAVILY_API_KEY=
