# Copy to .env and fill. Never commit .env.
TZ=UTC

# OpenClaw gateway
OPENCLAW_PORT=18789
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:latest
OPENCLAW_GATEWAY_TOKEN=change-me-to-a-long-random-token

# Telegram (BotFather -> /newbot). Restrict to your chat ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# 9Router
NINE_ROUTER_PORT=20128
NINE_ROUTER_IMAGE=decolua/9router:latest
# Dashboard password (replaces default 123456; required for browser access via Docker)
NINE_ROUTER_PASSWORD=change-me-to-a-long-random-password
# API key created in 9Router dashboard (Settings -> API Keys), pasted into OpenClaw model auth.
# Keep it here for reference only (gateway uses openclaw.json auth-profiles, not this var directly):
NINE_ROUTER_API_KEY=
TAVILY_API_KEY=
